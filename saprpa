def setup_logger():
    log_dir = get_logs_paths()
    log_dir.mkdir(exist_ok=True)

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    log_file = log_dir / f"SAP_KPIMonitoring_{timestamp}.log"

    logger = logging.getLogger("SAP_KPIMonitoring")
    logger.setLevel(logging.DEBUG)

    # Formato
    fmt = logging.Formatter(
        "[%(asctime)s] [%(levelname)-8s] %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S"
    )
     # Handler → archivo
    fh = logging.FileHandler(log_file, encoding="utf-8")
    fh.setLevel(logging.DEBUG)
    fh.setFormatter(fmt)

    # Handler → consola
    ch = logging.StreamHandler(sys.stdout)
    ch.setLevel(logging.INFO)
    ch.setFormatter(fmt)

    logger.addHandler(fh)
    logger.addHandler(ch)

    logger.info(f"Log started: {log_file}")
    return logger


def get_logs_paths():
    today = datetime.now().strftime("%y-%m-%d-logs")
    folder_name = f"logs_{today}"
    pathlogs = Path(BASE_LOG_DIR) / folder_name
    pathlogs.mkdir(parents=True, exist_ok=True)
    return pathlogs

def get_daily_ksi_file() -> str:
    """Get or create daily copy of KSI_MONITORING_FILE with today's date."""
    original_ksi = os.getenv("KSI_MONITORING_FILE")
    if not original_ksi or not Path(original_ksi).exists():
        raise ValueError(f"KSI_MONITORING_FILE no valido: {original_ksi}")
    
    today = datetime.now().strftime("%Y%m%d")
    ksi_src = Path(original_ksi)
    ksi_copy = ksi_src.with_name(f"Daily System Closing status_{today}{ksi_src.suffix}")
    
    if not ksi_copy.exists():
        shutil.copy2(ksi_src, ksi_copy)
        log.info(f"Created daily KSI copy: {ksi_copy}")
    else:
        log.info(f"Using existing daily KSI copy: {ksi_copy}")
    
    return str(ksi_copy)


def get_latest_file(directory, pattern="*"):
    """Busca el archivo más reciente en una carpeta con un patrón específico.
    
    Args:
        directory: Ruta de la carpeta donde buscar
        pattern: Patrón de nombre de archivo (ej: "Item Qty_*")
    
    Returns:
        Path del archivo más reciente o None si no encuentra
    """
    directory = Path(directory)
    files = sorted(directory.glob(pattern), key=lambda p: p.stat().st_mtime, reverse=True)
    return files[0] if files else None

def wait_element(session, element, timeout=15):
    start = time.time()
    while time.time() - start < timeout:
        try:
            return session.findById(element)
        except:
            time.sleep(1)
    raise Exception(f"Element not found: {element}")


def alert_contains(alert_text: str, *expected_fragments: str) -> bool:
    normalized_alert = (alert_text or "").strip().lower()
    return any(fragment.strip().lower() in normalized_alert for fragment in expected_fragments)

def read_shell_data(shell) -> list[list]:
    """
    Lee todos los datos de un GuiGridView celda por celda.

    Returns:
        Lista de listas con los valores de cada fila y columna.
    """
    rows = shell.rowCount
    col_count = shell.columnCount
    data = []
    for r in range(rows):
        row = []
        for c in range(col_count):
            col_name = shell.columnOrder(c)
            try:
                row.append(shell.getCellValue(r, col_name))
            except Exception:
                row.append("")
        data.append(row)
    return data


def export_shell_to_excel(session, shell, export_path: str, filename: str) -> None:
    """
    Exporta un GuiGridView a Excel usando el menú nativo de SAP (&MB_EXPORT).
    Usar para tablas grandes donde leer celda a celda sería lento.
    No depende del clipboard ni del foco del sistema operativo.
    """
    shell.pressToolbarContextButton("&MB_EXPORT")
    shell.selectContextMenuItem("&XXL")
    session.findById("wnd[1]/tbar[0]/btn[0]").press()
    session.findById("wnd[1]/usr/ctxtDY_PATH").text = export_path
    session.findById("wnd[1]/usr/ctxtDY_FILENAME").text = filename
    session.findById("wnd[1]/usr/ctxtDY_FILENAME").caretPosition = len(filename)
    session.findById("wnd[1]/tbar[0]/btn[0]").press()


def paste_to_sheet(wb, sheet_name: str, data: list[list], start_row: int, start_col: int) -> None:
    """
    Escribe una lista de listas en la hoja indicada del workbook.

    Args:
        wb: Workbook openpyxl abierto.
        sheet_name: Nombre de la hoja destino.
        data: Lista de filas, cada fila es una lista de valores.
        start_row: Fila inicial (1-indexed).
        start_col: Columna inicial (1-indexed).
    """
    ws = wb[sheet_name]
    for r_idx, row in enumerate(data, start=start_row):
        for c_idx, value in enumerate(row, start=start_col):
            ws.cell(row=r_idx, column=c_idx, value=value)
    log.info(f"Data written to sheet '{sheet_name}' ({len(data)} rows)")

def calculate_date():
    today = datetime.now()
    first_day_of_month = today.replace(day=1)
    yesterday = today - timedelta(days=1)
    current_month = today.strftime("%Y.%m")
    return first_day_of_month.strftime("%Y.%m.%d"), yesterday.strftime("%Y.%m.%d"), current_month

def delete_excel(path, nameFile):
    log.info("Cleaning up exported Excel files...")
    pattern = nameFile
    if not any(ch in nameFile for ch in "*?[]"):
        pattern = f"{nameFile}*.xlsx"

    latest_excel = get_latest_file(path, pattern)
    if latest_excel:
        try:
            os.remove(latest_excel)
            log.info(f"Deleted file: {latest_excel}")
        except Exception as e:
            log.error(f"Error deleting file {latest_excel}: {e}")
    else:
        log.info("No Excel file found to delete.")


def close_excel_workbook_if_open(workbook_name: str, timeout_seconds: int = 8) -> None:
    """
    Cierra una ventana de Excel que contenga workbook_name en su titulo.
    Busca por titulo de ventana (win32gui), lo que funciona independientemente
    de como SAP haya abierto Excel.
    """
    name_lower = (workbook_name or "").lower().strip()
    name_stem = Path(name_lower).stem
    deadline = time.time() + timeout_seconds
    log.info(f"Trying to close Excel workbook: {workbook_name}")

    def _find_and_close():
        found = []

        def _enum_callback(hwnd, _):
            if not win32gui.IsWindowVisible(hwnd):
                return
            title = win32gui.GetWindowText(hwnd).lower()
            if name_lower in title or (name_stem and name_stem in title):
                found.append(hwnd)

        win32gui.EnumWindows(_enum_callback, None)

        for hwnd in found:
            try:
                win32gui.PostMessage(hwnd, win32con.WM_CLOSE, 0, 0)
                log.info(f"Sent WM_CLOSE to Excel window with '{workbook_name}' in title")
            except Exception as e:
                log.debug(f"Error closing window {hwnd}: {e}")
        return bool(found)

    # Esperar a que la ventana aparezca y cerrarla
    while time.time() < deadline:
        if _find_and_close():
            time.sleep(0.5)   # dar tiempo a que procese el cierre
            return
        time.sleep(0.5)

    log.debug(f"No Excel window with '{workbook_name}' found within {timeout_seconds}s")


