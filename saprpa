def main():
    completed = False
    session = None
    wb = None
    ksi_file = None

    try:
        session = open_sap()
        if session is None:
            raise RuntimeError("No se pudo abrir sesion en SAP")

        log.info("Opening main Excel file...")
        wb, ksi_file = open_main_excel()

        item_error(session, wb)
        bom_error(session, wb)
        first_day_of_month, yesterday, current_month = calculate_date()
        process_ZRPPS1000(session, wb, first_day_of_month, yesterday)
        process_ZLSDH1000(session, wb, first_day_of_month, yesterday, current_month)
        process_ZLMMI5050(session, wb, first_day_of_month, yesterday, current_month, path_sap)
        log.info("Saving Excel workbook...")
        wb.save(ksi_file)
        log.info(f"Workbook saved: {ksi_file}")
        delete_excel(path_sap, "backlog")
        completed = True
        log.info("Proceso completado correctamente.")
    except Exception as e:
        log.exception(f"Proceso no completado. Error en main: {e}")
    finally:
        if wb is not None:
            wb.close()
            log.info("Workbook closed.")
            #os.system("taskkill /f /im excel.exe >nul 2>&1")
            #delete_excel(path_sap, "backlog")

        if not completed:
            log.error("El proceso no se completo.")

    return completed
    

if __name__ == "__main__":
    ok = main()
    sys.exit(0 if ok else 1)
