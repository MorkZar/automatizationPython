            except Exception:
                pass

            btn_download_excel = find_smart_any_frame(driver, By.ID, "btnGrid1ExcelDownload")
            btn_download_excel.click()

            time.sleep(0.5)
            body = driver.find_element(By.TAG_NAME, "body")
