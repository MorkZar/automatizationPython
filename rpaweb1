            # 실제 파일이 다운로드될 때까지 대기 (이전까지 본 파일 기준)
            excel_path = wait_for_new_file(DOWNLOAD_DIR, seen_files, timeout=120)
            print("다운로드 완료 파일:", excel_path, "존재 여부:", os.path.exists(excel_path))
            downloaded_files.append(excel_path)

            # 이번에 받은 파일을 seen_files에 추가
            seen_files.add(Path(excel_path).name)

        send_mail_with_attachments(downloaded_files)


    finally:
        driver.quit()


