downloaded_files = []

DRIVER_PATH_FILE = "chromedriver_path.txt"

def get_cached_driver_path():
    """캐시에 저장된 chromedriver 경로를 읽거나, 없으면 WebDriverManager로 받아서 저장."""
    # 1) 파일에 경로가 이미 저장되어 있으면 그거 사용
    if os.path.exists(DRIVER_PATH_FILE):
        with open(DRIVER_PATH_FILE, "r", encoding="utf-8") as f:
            path = f.read().strip()
        if path and os.path.exists(path):
            return path  # 이미 받아 둔 드라이버 재사용

    # 2) 없으면 WebDriverManager로 최초 한 번 다운로드 (느린 단계)
    os.environ["WDM_LOCAL"] = "1"  # 받은 후엔 로컬 캐시 우선 사용[web:42]
    driver_path = ChromeDriverManager().install()  # 여기서만 느릴 수 있음[web:41][web:47]

    # 3) 경로를 파일에 저장해 두고 다음부터는 그대로 사용
    with open(DRIVER_PATH_FILE, "w", encoding="utf-8") as f:
        f.write(driver_path)

    return driver_path


def switch_to_frame_with_element(driver, by, locator, timeout=10):
    """주어진 locator를 포함한 iframe을 찾아 그 iframe으로 switch."""
    wait = WebDriverWait(driver, timeout)

    driver.switch_to.default_content()
    iframes = driver.find_elements(By.TAG_NAME, "iframe")
    print("iframe 개수:", len(iframes))

    for idx, frame in enumerate(iframes):
        driver.switch_to.default_content()
        driver.switch_to.frame(frame)
        try:
            wait.until(ec.presence_of_element_located((by, locator)))
            print(f">>> 이 프레임에서 {locator} 찾음! index = {idx}")
            return idx  # 필요한 경우 인덱스를 저장해서 재사용 가능
        except Exception:
            continue

    raise Exception(f"어느 iframe에서도 요소 {locator} 를 찾지 못했습니다.")

current_frame = None  # 지금까지 잘 쓰이던 프레임 캐시


def find_smart_any_frame(driver, by, locator, timeout=3):
    global current_frame
    wait = WebDriverWait(driver, timeout)

    # 1) 먼저 "기존에 잘 되던 프레임"에서만 시도
    if current_frame is not None:
        try:
            driver.switch_to.default_content()
            driver.switch_to.frame(current_frame)
            return wait.until(ec.presence_of_element_located((by, locator)))
        except Exception:
            pass  # 여기서 못 찾으면 아래로 내려가서 전체 탐색

    # 2) 실패하면 전체 iframe을 돌면서 다시 탐색
    driver.switch_to.default_content()
    iframes = driver.find_elements(By.TAG_NAME, "iframe")

    for frame in iframes:
        driver.switch_to.default_content()
        driver.switch_to.frame(frame)
        try:
            elem = wait.until(ec.presence_of_element_located((by, locator)))
            # 이 프레임이 유효하다는 걸 알았으니 캐시에 저장
            current_frame = frame
            return elem
        except Exception:
            continue

    raise Exception(f"어느 iframe에서도 요소 {locator} 를 찾지 못했습니다.")


def find_in_any_frame(driver, by, locator, timeout=10):
    """여러 iframe 중 해당 요소를 포함한 프레임을 찾아 진입 후 요소 반환."""
    driver.switch_to.default_content()
    iframes = driver.find_elements(By.TAG_NAME, "iframe")
    wait = WebDriverWait(driver, timeout)

    for frame in iframes:
        driver.switch_to.default_content()
        driver.switch_to.frame(frame)
        try:
            elem = wait.until(ec.presence_of_element_located((by, locator)))
            return elem
        except Exception:
            continue

    raise Exception(f"어느 iframe에서도 요소 {locator} 를 찾지 못했습니다.")


def wait_for_new_file(download_dir, seen_files, timeout=120):
    """seen_files 이후 '완료된' 새 파일(.tmp/.crdownload 제외)을 기다린다."""
    folder = Path(download_dir)
    start = time.time()

    while time.time() - start < timeout:
        time.sleep(1)

        # 폴더 내 파일 목록
        current_files = {f.name for f in folder.glob("*")}

        # 아직 임시 파일(.tmp, .crdownload)이 남아 있으면 그냥 계속 기다림
        if any(
            name.endswith((".tmp", ".crdownload", ".part"))
            for name in current_files
        ):
            continue

        # seen_files 이후에 생긴 '완료된' 새 파일들만 필터
        new_files = current_files - seen_files
        if new_files:
            latest = max(
                new_files,
                key=lambda n: (folder / n).stat().st_mtime
            )
            return str(folder / latest)

    raise TimeoutError("다운로드 완료 파일을 찾지 못했습니다.")


def send_mail_with_attachments(attachment_paths):
    outlook = win32.Dispatch("Outlook.Application")
    mail = outlook.CreateItem(0)

    mail.To = ""  #To 정보
    mail.CC = ""  #Cc 정보
    mail.Subject = "GMES 재고 엑셀 자동전송"  #이메일 제목 수정하려면 여기 수정
    mail.Body = "Inventory Status Display 재고 조회 자동 전송\n 전 Plant\n RPA 테스트 완료\n"  #이메일 내용 수정하려면 여기 수정

    for path in attachment_paths:
        print("첨부 시도 파일:", path)
        if not os.path.exists(path):
            print("⚠ 파일이 실제로 없음:", path)
            continue  # 존재하지 않으면 첨부 건너뛰기

        # 절대 경로 보장 (혹시 모를 문제 방지)
        abs_path = str(Path(path).resolve())
        print("실제 첨부 경로:", abs_path)
        mail.Attachments.Add(abs_path)
    mail.Send()


def main():
    driver_path = get_cached_driver_path()
    service = ChromeService(executable_path=driver_path)
    driver = webdriver.Chrome(service=service)

