            time.sleep(0.3)

            options = driver.find_elements(
                By.XPATH, "//td[starts-with(@id, 'cboSearchPlant_itemTable_')]"
            )
            opt = options[i]
            print(i, opt.get_attribute("id"), " / text =", opt.text)
            opt.click()

            btn_inquiry = find_smart_any_frame(driver, By.ID, "btnMainSearch")
            btn_inquiry.click()

            # 조회 후 로딩바 사라질 때까지 대기
            try:
                WebDriverWait(driver, 10).until(
                    ec.invisibility_of_element_located((By.ID, "loadingBar"))
                )
            except Exception:
                pass

            rows = wait.until(
                ec.presence_of_all_elements_located(
                    (By.CSS_SELECTOR, "#grid1_cell_0_0")
                )
            )

            # 다운로드 전에도 한 번 더 체크 (짧게)
            try:
                WebDriverWait(driver, 5).until(
                    ec.invisibility_of_element_located((By.ID, "loadingBar"))
