def get_logs_paths():
    today = datetime.now().strftime("%y-%m-%d-logs")
    folder_name = f"logs_{today}"
    pathlogs = Path(BASE_LOG_DIR) / folder_name
    pathlogs.mkdir(parents=True, exist_ok=True)
    return pathlogs

def setup_logger():
    log_dir = get_logs_paths()
    log_dir.mkdir(exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    log_file = log_dir / f"GMES_KPIMonitoring_{timestamp}.log"
    logger = logging.getLogger("GMES_KPIMonitoring")
    logger.setLevel(logging.DEBUG)
    # Formato
    fmt = logging.Formatter(
        "[%(asctime)s] [%(levelname)-8s] %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S"
    )
     # Handler → archivo
    fh = logging.FileHandler(log_file, encoding="utf-8")
    fh.setLevel(logging.DEBUG)
    fh.setFormatter(fmt)
    # Handler → consola
    ch = logging.StreamHandler(sys.stdout)
    ch.setLevel(logging.INFO)
    ch.setFormatter(fmt)
    logger.addHandler(fh)
    logger.addHandler(ch)
    logger.info(f"Log started: {log_file}")
    return logger

def delete_all_excels(path: str) -> None:
    """
    Elimina todos los archivos Excel (.xls, .xlsx) dentro de la carpeta especificada.
    """
    log.info("Cleaning up all Excel files in folder...")

    try:
        for file in os.listdir(path):
            if file.endswith((".xls", ".xlsx")):
                file_path = os.path.join(path, file)
                try:
                    os.remove(file_path)
                    log.info(f"Deleted file: {file_path}")
                except Exception as e:
                    log.error(f"Error deleting file {file_path}: {e}")
        log.info("Excel cleanup completed.")
    except Exception as e:
        log.error(f"Error accessing folder {path}: {e}")
        

