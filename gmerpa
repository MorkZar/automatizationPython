def run_def_remain_case(driver, wait, wb, download_path, log, start, end):
    log.info("Starting Def Remain Process...")
    driver.switch_to.default_content()
    menu_candidates = [
        "//*[normalize-space(text())='Defect Confirm action Mgmt.']",
        "//*[normalize-space(text())='Defect Confirm Action Mgmt.']",
        "//*[contains(normalize-space(text()), 'Defect Confirm') and contains(normalize-space(text()), 'Mgmt')]",
    ]

    el1 = None
    for xpath in menu_candidates:
        try:
            el1, _ = find_element_in_default_or_iframes(driver, By.XPATH, xpath, timeout=10)
            break
        except TimeoutException:
            continue

    if el1 is None:
        raise TimeoutException("Defect Confirm action Mgmt menu not found")

    driver.execute_script("arguments[0].scrollIntoView(true);", el1)
    try:
        el1.click()
    except Exception:
        driver.execute_script("arguments[0].click();", el1)
    log.debug("Defect Confirm action Mgmt. clicked")

    log.info("Switch iframe...")
    driver.switch_to.frame("mainTabControl_contents_3129_body")
    wait_frame = WebDriverWait(driver, 10)
    time.sleep(1)
    start_date = wait.until(EC.presence_of_element_located((By.ID, "txtSearchPeriodBeginDate_input")))
    start_date.clear()
    start_date.send_keys(start)
    start_date.send_keys(Keys.RETURN)
    log.info(f"Date set to: {start}")

    input_date = wait.until(EC.presence_of_element_located((By.ID, "txtSearchPeriodEndDate_input")))
    input_date.clear()
    input_date.send_keys(end)
    input_date.send_keys(Keys.RETURN)
    log.info(f"Date set to: {end}")
    time.sleep(2)

    unconfirmed_button = wait_frame.until(EC.element_to_be_clickable((By.ID, "chbIS_button")))
    driver.execute_script("arguments[0].scrollIntoView(true);", unconfirmed_button)
    unconfirmed_button.click()
    unconfirmed_options = wait_frame.until(EC.presence_of_element_located((By.ID, "chbIS_itemTable_1")))
    driver.execute_script("arguments[0].scrollIntoView(true);", unconfirmed_options)
    wait_frame.until(EC.element_to_be_clickable((By.ID, "chbIS_itemTable_1"))).click()
    log.info("Option 'Unconfirmed' selected")

    log.info("Excecuting main search...")
    inquiry(driver)
    log.info("Búsqueda iniciada")

    download_excel(driver, btn_id="btngridDownloadExcel1", file_name="Failure Confirm action Mgmt.")
    log.info("Excel Downloaded")
    log.info("Processing Excel file and copying to KSI...")
    process_excel(
        wb,
        download_path,
        log,
        "Failure Confirm action Mgmt.",
        "Def. Remain",
        3,
        3,
        3,
        cols_to_delete=[2, 3, 12, 13],
    )
    log.info("Defect Remain processing completed")


def run_selenium(wb,download_path, log, start, end):
    with managed_driver(download_path) as driver:
        wait = WebDriverWait(driver, 10)
        log.info(f"Navegando a: {URL}")
        driver.get(URL)

        try:
            WebDriverWait(driver, 3).until(EC.alert_is_present())
            alert = driver.switch_to.alert
            log.info(f"Alert detected: {alert.text}")
            alert.accept()
            log.info("Alert was acepted (OK)")
        except TimeoutException:
            log.debug("No alert")

        run_login_case(driver, wait, log)
        wait_frame = run_itrmqty_case(driver, wait, wb, download_path, log)
        run_itembar_case(driver, wait_frame, wb, download_path, log)
        run_mcm_monitoring_case(driver, wait_frame, download_path, log)
        run_wip_rm_defect_case(driver, wait, wb, download_path, log, start, end)
        run_def_remain_case(driver, wait, wb, download_path, log, start, end)
        log.info("All processes completed successfully")
               
def main():
    validate_env(log)
    start, end = get_date_range() 
    temp_file = KPI_TEMPLATE_DIR
    ksi_working_file = get_latest_file(temp_file, "Daily System Closing status_*.xlsx")
    wb = None
    ksi_file = None

    try:
        log.info("Starting GMES automation...")
        log.info("Opening main Excel file...")
        wb, ksi_file = open_main_excel(ksi_working_file)
        run_selenium(wb, download_path, log, start, end)
        today_str = datetime.now().strftime("%Y%m%d")
        new_name = Path(ksi_file).parent / f"Daily System Closing status_{today_str}.xlsx"
        log.info(f"Saving KSI file as: {new_name.name}")
        log.info("Saving changes to KSI Excel file...")
        wb.save(new_name)  
    except TimeoutException as e:
        log.error(f"Timeout esperando elemento: {e}")
        sys.exit(2)
    except WebDriverException as e:
        log.error(f"Error WebDriver: {e}")
        sys.exit(3)
    except TimeoutError as e:
        log.error(f"Descarga no completada: {e}")
        sys.exit(4)
    except Exception as e:
        log.critical(f"An error occurred: {e}")
        sys.exit(1)
    finally:
        delete_all_excels(get_download_path())
        delete_all_excels(LOCAL_TEMP_DIR) 
        if wb is not None:
            wb.close()  # Cerrar el archivo de Excel

    log.info("✅ Automatización completada exitosamente")

if __name__ == "__main__":
    main()
