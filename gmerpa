def get_cached_driver_path():
    """Lee driver guardado o descarga uno nuevo."""

    # Revisar si ya existe archivo con la ruta
    if Path(DRIVER_PATH_FILE).exists():

        with open(DRIVER_PATH_FILE, "r", encoding="utf-8") as f:
            path = f.read().strip()

        # Verificar que el driver todavía exista
        if path and os.path.exists(path):
            log.info(f"Using cached ChromeDriver: {path}")
            return path

    # Si no existe → descargar
    log.info("Downloading new ChromeDriver...")

    os.environ["WDM_LOCAL"] = "1"

    driver_path = ChromeDriverManager().install()

    # Guardar ruta
    with open(DRIVER_PATH_FILE, "w", encoding="utf-8") as f:
        f.write(driver_path)

    log.info(f"ChromeDriver downloaded: {driver_path}")

    return driver_path

