def get_date_range():
    """
    Si hoy es la primera semana del mes (días 1-7):
        → rango: hace 7 días hasta ayer
    Si no es la primera semana:
        → rango: primer día del mes hasta ayer
    
    Returns:
        tuple: (start_date, end_date) en formato "YYYY.MM.DD"
    """
    today = datetime.now()
    yesterday = today - timedelta(days=1)
    
    is_first_week = today.day <= 7
    
    if is_first_week:
        start_date = today - timedelta(days=7)
    else:
        start_date = today.replace(day=1)
    
    return start_date.strftime("%Y.%m.%d"), yesterday.strftime("%Y.%m.%d")

