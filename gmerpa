def inquiry(driver, max_retries=3, results_wait_timeout=660, post_wait_seconds=1):
    for attempt in range(1, max_retries + 1):
        try:
            log.info(f"Starting Excel Download (attempt {attempt})...")
            # ── 6. Ejecutar búsqueda ──────────────────────────────────────────────
            wait_frame = WebDriverWait(driver, 20)
            log.info("Excecuting main search...")
            wait_frame.until(EC.element_to_be_clickable((By.ID, "btnMainSearch"))).click()
            log.info("Búsqueda iniciada")

            # ── 7. Esperar resultados ─────────────────────────────────────────────
            log.info("Waiting for loading bar...")
            WebDriverWait(driver, results_wait_timeout).until(
            EC.invisibility_of_element_located((By.ID, "lbMsg"))
            )
            log.info("Results loaded")

            try:
               WebDriverWait(driver, 3).until(EC.alert_is_present())
               alert = driver.switch_to.alert
               log.warning(f"Alert detected: {alert.text}")
               alert.accept()
            except TimeoutException:
                log.warning("No alert detected")

            # Espera extra para que el archivo termine de escribirse
            time.sleep(post_wait_seconds)

            log.info("✅ Excel Charged successfully")
            return True  # salida exitosa

        except (TimeoutException, WebDriverException) as e:
            log.error(f"⚠️ Download failed on attempt {attempt}: {e}")

            if attempt < max_retries:
                log.info("Retrying after waiting 15 seconds...")
                time.sleep(15)
            else:
                log.critical("❌ Max retries reached. Download failed.")
                raise


def download_excel(
    driver,
    max_retries=3,
    btn_id=None,
    file_name=None,
    progress_wait_timeout=180,
    post_wait_seconds=5,
):

    for attempt in range(1, max_retries + 1):
        try:
            log.info(f"Starting Excel Download (attempt {attempt})...")

            # Espera botón clickeable
            download_btn = WebDriverWait(driver, 20).until(
                EC.element_to_be_clickable((By.ID, btn_id))
            )

            download_btn.click()
            log.debug("Excel download button clicked")

            time.sleep(1)

            # Confirmación (ENTER)
            driver.switch_to.active_element.send_keys(Keys.ENTER)
            log.info("Download confirmation sent (ENTER)")

            # Manejo de alertas (si aparecen)
            try:
                WebDriverWait(driver, 5).until(EC.alert_is_present())
                alert = driver.switch_to.alert
                log.warning(f"Alert detected: {alert.text}")
                alert.accept()
            except TimeoutException:
                log.info("No alert detected")

            # Espera a que desaparezca el mensaje de progreso
            WebDriverWait(driver, progress_wait_timeout).until(
                EC.invisibility_of_element_located((By.ID, "lbMsg"))
            )

            # Espera extra para que el archivo termine de escribirse
            time.sleep(post_wait_seconds)

            downloaded_file = None
            if file_name:
                downloaded_file = wait_excel(file_name)
                log.info(f"Excel file ready: {downloaded_file.name}")

            log.info("✅ Excel downloaded successfully")
            return downloaded_file if downloaded_file else True  # salida exitosa

        except (TimeoutException, WebDriverException) as e:
            log.error(f"⚠️ Download failed on attempt {attempt}: {e}")

            if attempt < max_retries:
                log.info("Retrying after waiting 10 seconds...")
                time.sleep(10)
            else:
                log.critical("❌ Max retries reached. Download failed.")
                raise 

        
def wait_excel(file_name):
    """Espera a que el archivo Excel esté completamente guardado y no esté bloqueado."""
    while True:
        latest_file = get_latest_file(get_download_path(), f"{file_name}*.xlsx")
        if latest_file and not latest_file.stat().st_size == 0:
            try:
                # Intentar abrir el archivo para verificar que no esté bloqueado
                with open(latest_file, "rb"):
                    return latest_file
            except IOError:
                time.sleep(1)  # Esperar un segundo antes de intentar de nuevo
        else:
            time.sleep(1)  # Esperar un segundo antes de verificar nuevamente


def find_element_in_default_or_iframes(driver, by, value, timeout=20):
    """Busca un elemento en default_content y en iframes del mismo documento."""
    end_time = time.time() + timeout
    while time.time() < end_time:
        driver.switch_to.default_content()

        # Intento en documento principal
        elements = driver.find_elements(by, value)
        if elements:
            return elements[0], "default_content"

        # Intento en cada iframe
        frames = driver.find_elements(By.TAG_NAME, "iframe")
        for idx, _ in enumerate(frames):
            try:
                driver.switch_to.default_content()
                current_frames = driver.find_elements(By.TAG_NAME, "iframe")
                if idx >= len(current_frames):
                    continue
                driver.switch_to.frame(current_frames[idx])
                elements = driver.find_elements(by, value)
                if elements:
                    return elements[0], f"iframe[{idx}]"
            except Exception:
                continue

        time.sleep(0.5)

    raise TimeoutException(f"Element not found in default/iframes: {by}={value}")

def calculate_yesterday_date():
    yesterday = datetime.now() - timedelta(days=1)
    return yesterday.strftime("%Y%m%d")           


def is_http_read_timeout_error(error):
    message = str(error)
    return "HTTPConnectionPool" in message and "Read timed out" in message
            
def process_excel(wb,download_path, log, nombre_archivo, sheet_name, start_row, start_col, delete_row, cols_to_delete=None):
    log.info("Processing Excel file...")
    latest_excel = get_latest_file(download_path, f"{nombre_archivo}*.xlsx")
    if latest_excel:
        log.info(f"Opening latest file: {latest_excel.name}")
    wb_src = load_workbook(latest_excel)
    ws_src = wb_src.active
    
    log.info("Cleaning extra rows...")
    # Limpiar filas sobrantes
    ws_src.delete_rows(1, delete_row)
    ws_src.delete_rows(ws_src.max_row, 1)

    if cols_to_delete:
        log.info(f"Deleting source columns: {cols_to_delete}")
        for col_idx in sorted(cols_to_delete, reverse=True):
            ws_src.delete_cols(col_idx, 1)

    log.info("Opening KSI...")
    wb_dst = wb
    ws_dst = wb_dst[sheet_name]

    # Escritura directa sin lista intermedia en RAM
    for r_idx, row in enumerate(ws_src.iter_rows(values_only=True), start=start_row):
        for c_idx, value in enumerate(row, start=start_col):
            ws_dst.cell(row=r_idx, column=c_idx, value=value)

    wb_src.close()
    wb.calculation.calcMode = "auto"
    #wb.calculation.fullCalcOnLoad = True
    log.info("✅ Datos copiados y guardados")

